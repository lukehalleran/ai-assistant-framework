+# These OpenRouter routes omit the listed parameters from GET /api/v1/models.
+_OPENROUTER_UNSUPPORTED_PARAMETERS = {
+    "anthropic/claude-fable-5.1": frozenset({"temperature", "top_p", "tool_choice"}),
+    "openai/gpt-6-astra": frozenset({"temperature", "top_p", "stop"}),
+}
+_ALWAYS_ON_REASONING_MODELS = frozenset({
+    "anthropic/claude-fable-5.1",
+    "openai/gpt-6-astra",
+})
+_SYNC_REASONING_MODELS = frozenset({
+    "deepseek/deepseek-v4.1-flash",
+    "anthropic/claude-fable-5.1",
+    "openai/gpt-6-astra",
+})
+
+
+def _filter_openrouter_request_params(full_slug: str, params: dict) -> dict:
+    """Drop parameters this exact OpenRouter model route does not advertise."""
+    unsupported = _OPENROUTER_UNSUPPORTED_PARAMETERS.get(str(full_slug), frozenset())
+    return {key: value for key, value in params.items() if key not in unsupported}
+
+
+def _slug_supports_openrouter_parameter(full_slug: str, parameter: str) -> bool:
+    """Whether this model route advertises a parameter in OpenRouter metadata."""
+    return parameter not in _OPENROUTER_UNSUPPORTED_PARAMETERS.get(
+        str(full_slug), frozenset()
+    )
+
+
+def _unsupported_tool_choice_error(full_slug: str, tool_choice) -> str:
+    """Classify unsupported explicit tool selection before sending a request."""
+    if _slug_supports_openrouter_parameter(full_slug, "tool_choice"):
+        return ""
+    if tool_choice is None or tool_choice == "auto" or tool_choice == "none":
+        return ""
+    return (
+        f"[MODEL NOT SUPPORTED] {full_slug} via OpenRouter does not advertise "
+        "forced tool_choice. Use auto tool selection or switch models."
+    )
+
+
+def _reasoning_request_config(full_slug: str, disable_reasoning: bool = False) -> dict:
+    """Build route-compatible reasoning settings, preserving mandatory reasoning."""
+    if not disable_reasoning:
+        if str(full_slug) == "deepseek/deepseek-v4.1-flash":
+            # OpenRouter advertises low/high/max for this route; low is the
+            # cost-conscious valid effort and avoids sending unsupported medium.
+            return {"effort": "low"}
+        return {"effort": "medium"}
+    if str(full_slug) in _ALWAYS_ON_REASONING_MODELS:
+        # These routes require reasoning; low effort and exclusion cannot disable it.
+        return {"effort": "low", "exclude": True}
+    return {"enabled": False}
 
 
